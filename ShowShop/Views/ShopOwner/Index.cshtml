@{
    Layout = "~/Views/Shared/ShopAdminLayout.cshtml";
}

            <div class="page-header">
                <div class="page-header-text">
                    <h1>Good morning, Emeka 👋</h1>
                    <p>Here's what's happening with your shop today.</p>
                </div>
                <div class="page-header-actions">
                    <a class="btn btn-primary" href="add-product.html">+ Add Product</a>
                </div>
            </div>

            <!-- Onboarding Banner -->
            <div class="onboarding-banner">
                <div class="onboarding-text">
                    <h3>Your shop is live — now fill it up!</h3>
                    <p>You've registered successfully. The next step is to add your first product so customers can start pre-ordering. It only takes a minute.</p>
                </div>
                <div class="onboarding-actions">
                    <a class="btn btn-white" href="add-product.html">+ Add First Product</a>
                    <button class="btn btn-ghost">Share Shop Link</button>
                </div>
            </div>

            <!-- Setup Steps -->
            <div class="steps-row">
                <div class="step done">
                    <div class="step-num">✓</div>
                    <div class="step-text">
                        <strong>Account Created</strong>
                        <span>Phone verified via WhatsApp</span>
                    </div>
                </div>
                <div class="step active">
                    <div class="step-num">2</div>
                    <div class="step-text">
                        <strong>Add Products</strong>
                        <span>Upload your first catalog item</span>
                    </div>
                </div>
                <div class="step todo">
                    <div class="step-num">3</div>
                    <div class="step-text">
                        <strong>Share Shop Link</strong>
                        <span>Send to customers via WhatsApp</span>
                    </div>
                </div>
                <div class="step todo">
                    <div class="step-num">4</div>
                    <div class="step-text">
                        <strong>Receive Orders</strong>
                        <span>Manage pre-orders from dashboard</span>
                    </div>
                </div>
            </div>

            <!-- Stats -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon orange">⏳</div>
                    <div class="stat-info">
                        <strong>3</strong>
                        <span>Pending Orders</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon green">✅</div>
                    <div class="stat-info">
                        <strong>1</strong>
                        <span>Ready for Pickup</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon blue">📦</div>
                    <div class="stat-info">
                        <strong>0</strong>
                        <span>Total Products</span>
                    </div>
                </div>
            </div>

            <!-- My Shops -->
            <div class="section-header">
                <h2>My Shops</h2>
                <a href="#">+ Create New Shop</a>
            </div>

            <div class="shops-grid">
                <div class="shop-card">
                    <div class="shop-card-top">
                        <div class="shop-avatar">EO</div>
                        <div class="shop-meta">
                            <strong>Emeka Plumbing Supplies</strong>
                            <span>Plumbing Materials · Lagos</span>
                        </div>
                    </div>
                    <div class="shop-stats">
                        <div class="shop-stat"><strong>0</strong><span>Products</span></div>
                        <div class="shop-stat"><strong>3</strong><span>Orders</span></div>
                        <div class="shop-stat"><strong>0</strong><span>Resellers</span></div>
                    </div>
                    <div class="shop-card-actions">
                        <button class="btn btn-primary btn-sm"
                                onclick="window.location='add-product.html'">
                            + Add Product
                        </button>
                        <button class="btn btn-outline btn-sm">Share Link 🔗</button>
                    </div>
                </div>

                <div class="shop-card new-shop">
                    <div class="new-shop-icon">+</div>
                    <strong>Create New Shop</strong>
                    <span>Add a second catalog with different pricing</span>
                </div>
            </div>

            <!-- Recent Orders -->
            <div class="section-header">
                <h2>Recent Orders</h2>
                <a href="#">View all orders</a>
            </div>

            <div class="orders-table-wrap">
                <div class="orders-table-header">
                    <h2>Orders Inbox</h2>
                    <a class="btn btn-primary btn-sm" href="#">View All</a>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Items</th>
                            <th>Amount</th>
                            <th>Time</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="order-id">#SQ-0031</span></td>
                            <td>Adaeze Nwosu</td>
                            <td><span class="order-items">4-inch PVC pipe × 2, Elbow joint × 4</span></td>
                            <td>₦14,500</td>
                            <td>9:42 AM</td>
                            <td><span class="status-pill pill-new">● New</span></td>
                        </tr>
                        <tr>
                            <td><span class="order-id">#SQ-0030</span></td>
                            <td>Chika (Reseller)</td>
                            <td><span class="order-items">Gate valve 2" × 1, PVC Tee × 3</span></td>
                            <td>₦22,000</td>
                            <td>Yesterday</td>
                            <td><span class="status-pill pill-ready">✓ Ready</span></td>
                        </tr>
                        <tr>
                            <td><span class="order-id">#SQ-0029</span></td>
                            <td>Bello Ibrahim</td>
                            <td><span class="order-items">Pressure gauge × 1</span></td>
                            <td>₦6,800</td>
                            <td>Yesterday</td>
                            <td><span class="status-pill pill-done">Completed</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>

