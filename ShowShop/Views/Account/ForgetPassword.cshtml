

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ShopShow — Forgot Password</title>
    <!-- Load layout + global CSS -->
    <link rel="stylesheet" href="../css/site.css" />
    <link rel="stylesheet" href="../css/account-layout.css" />
</head>
<body class="account-layout" style="display:flex; flex-direction:column;">

    <!-- ── ACCOUNT NAV ── -->
    <nav class="account-nav">
        <a class="logo" href="#">
            @*  <div class="logo-icon">SQ</div>
            <span class="logo-text">ShopQueue</span> *@
        </a>
        <ul>
            <li><a href="#" class="active">HOME</a></li>
            @*   <li><a href="#">HOW IT WORKS</a></li>
            <li><a href="#">PRICING</a></li>
            <li><a href="#">FOR RESELLERS</a></li> *@
            <li><a href="#">CONTACT</a></li>
        </ul>
    </nav>

    <!-- ── PAGE BODY ── -->
    <main class="account-main">
        <div class="account-card fade-up">

            <!-- LEFT PANEL -->
            <div class="panel-left">
                <div class="logo">
                    <div class="logo-icon">SS</div>
                    <span class="logo-text">ShopShow</span>
                </div>

                <div class="panel-tagline">
                    <h2>Sell smarter.<br />No queue,<br />no chaos.</h2>
                    <p>Digitize your product catalog, share your shop link, and let customers pre-order before they arrive. Built for local businesses and reseller networks across Nigeria.</p>
                </div>

                <div class="panel-badges">
                    <span class="panel-badge">🏪 Built for local shop owners</span>
                    <span class="panel-badge">🔗 Reseller-ready</span>
                    <span class="panel-badge">📲 WhatsApp-first</span>
                </div>
            </div>

            <!-- RIGHT PANEL -->
            <div class="panel-right">
                <h1>Forgot password? 🔑</h1>
                <p class="subtitle">No worries! Enter your email and we'll send you a reset link.</p>

                <form onsubmit="return false;">
                    <div class="form-group">
                        <label for="email">Email address</label>
                        <input type="email" id="email" placeholder="you@example.com" />
                    </div>

                    <button class="btn-login" type="submit"
                            onclick="handleReset()">
                        Send Reset Link →
                    </button>
                </form>

                <p class="auth-footer-link">
                    Remember your password? <a href="Login">Sign in</a>
                </p>
            </div>

        </div>
    </main>

    <script>
        function handleReset() {
            const email = document.getElementById('email').value;
            if (!email) return;
            // Replace this with your actual form submission / Razor handler
            window.location = 'ForgetPasswordConfirmation?email=' + encodeURIComponent(email);
        }
    </script>

</body>
</html>

































