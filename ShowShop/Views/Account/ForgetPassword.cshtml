        function resend() {
          const btn = event.target;
          btn.textContent = 'Link resent ✓';
          btn.style.color = '#43a047';
          btn.style.borderColor = '#43a047';
          btn.disabled = true;
          setTimeout(() => {
            btn.textContent = "Didn't receive it? Resend";
            btn.style.color = '';
            btn.style.borderColor = '';
            btn.disabled = false;
