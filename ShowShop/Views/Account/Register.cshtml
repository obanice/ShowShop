<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ShopQueue — Create Account</title>
    <link rel="stylesheet" href="../css/site.css" />
    <link rel="stylesheet" href="../css/account-layout.css" />
</head>
<body class="account-layout" style="display:flex; flex-direction:column;">

    <!-- ── ACCOUNT NAV ── -->
    <nav class="account-nav">
        <a class="logo" href="#">
            <div class="logo-icon">SS</div>
            <span class="logo-text">ShopShow</span>
        </a>
        <ul>
            <li><a href="Home/Index">HOME</a></li>
            <li><a href="Home/Index">HOW IT WORKS</a></li>
     @*        <li><a href="#">PRICING</a></li>
            <li><a href="#">FOR RESELLERS</a></li> *@
            <li><a href="#">CONTACT</a></li>
        </ul>
        <a class="nav-cta" href="Login">Sign In →</a>
    </nav>

    <!-- ── PAGE BODY ── -->
    <main class="account-main">
        <div class="account-card fade-up">

            <!-- LEFT PANEL -->
            <div class="panel-left">
              @*   <div class="logo">
                    <div class="logo-icon">SQ</div>
                    <span class="logo-text">ShopQueue</span>
                </div> *@

                <div class="panel-tagline">
                    <h2>Join thousands of Nigerian businesses going digital.</h2>
                    <p>Whether you own a shop, resell products, or just want to pre-order — ShopQueue has a role built for you.</p>
                </div>

                <!-- Role previews — highlighted by JS as user picks a tab -->
                <div class="role-previews">
                    <div class="role-preview-card active-role" id="preview-owner">
                        <div class="role-icon">🏪</div>
                        <div class="role-info">
                            <strong>Shop Owner</strong>
                            <span>Digitize your catalog & receive pre-orders</span>
                        </div>
                    </div>
                    <div class="role-preview-card" id="preview-reseller">
                        <div class="role-icon">🔗</div>
                        <div class="role-info">
                            <strong>Reseller</strong>
                            <span>Sell from any shop — zero inventory needed</span>
                        </div>
                    </div>
                    <div class="role-preview-card" id="preview-customer">
                        <div class="role-icon">🛒</div>
                        <div class="role-info">
                            <strong>Customer</strong>
                            <span>Browse & pre-order before you visit the shop</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT PANEL -->
            <div class="panel-right">
                <h1>Create your account</h1>
                <p class="subtitle">Pick your role and get started in minutes.</p>

                <!-- Role tabs -->
                <div class="role-tabs">
                    <button class="role-tab active" onclick="switchRole('owner', this)">
                        <span class="tab-icon">🏪</span> Shop Owner
                    </button>
                    <button class="role-tab" onclick="switchRole('reseller', this)">
                        <span class="tab-icon">🔗</span> Reseller
                    </button>
                    <button class="role-tab" onclick="switchRole('customer', this)">
                        <span class="tab-icon">🛒</span> Customer
                    </button>
                </div>

                <form onsubmit="return false;">

                    <!-- Common fields -->
                    <div class="form-row">
                        <div class="form-group">
                            <label>First name</label>
                            <input type="text" placeholder="Emeka" />
                        </div>
                        <div class="form-group">
                            <label>Last name</label>
                            <input type="text" placeholder="Okafor" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Email address</label>
                        <input type="email" placeholder="you@example.com" />
                    </div>

                    <div class="form-group">
                        <label>WhatsApp phone number</label>
                        <div class="phone-wrapper">
                            <div class="phone-prefix">🇳🇬 +234</div>
                            <input type="tel" placeholder="8012345678" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" placeholder="Min. 8 characters" />
                    </div>

                    <!-- Shop Owner extra fields -->
                    <div class="dynamic-fields visible" id="fields-owner">
                        <div class="form-group">
                            <label>Shop / Business name</label>
                            <input type="text" placeholder="e.g. Emeka Plumbing Supplies" />
                        </div>
                        <div class="form-group">
                            <label>Business type</label>
                            <select>
                                <option value="" disabled selected>Select your business category</option>
                                <option>Plumbing Materials</option>
                                <option>Building Materials</option>
                                <option>Fashion &amp; Clothing</option>
                                <option>Electronics</option>
                                <option>Supermarket / Groceries</option>
                                <option>Pharmacy</option>
                                <option>Auto Parts</option>
                                <option>Other</option>
                            </select>
                        </div>
                    </div>

                    <!-- Reseller extra fields -->
                    <div class="dynamic-fields" id="fields-reseller">
                        <div class="form-group">
                            <label>Your reseller / brand name</label>
                            <input type="text" placeholder="e.g. Chika Deals" />
                        </div>
                    </div>

                    <!-- Customer — no extra fields -->
                    <div class="dynamic-fields" id="fields-customer"></div>

                    <div class="terms">
                        <input type="checkbox" id="terms-check" />
                        <label for="terms-check">
                            I agree to ShopQueue's <a href="#">Terms of Service</a> and
                            <a href="#">Privacy Policy</a>. A WhatsApp OTP will be sent to verify your phone number.
                        </label>
                    </div>

                    <button class="btn-register" id="register-btn" type="submit"
                            onclick="window.location='dashboard.html'">
                        Create Shop Owner Account →
                    </button>

                </form>

               @*  <div class="divider">or sign up with</div>

                <button class="btn-whatsapp">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#25d366">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                    </svg>
                    Continue via WhatsApp
                </button> *@

                <p class="auth-footer-link">
                    Already have an account? <a href="Login">Sign in</a>
                </p>
            </div>

        </div>
    </main>

    <script>
        const roleConfig = {
          owner:    { label: 'Create Shop Owner Account',  preview: 'preview-owner'    },
          reseller: { label: 'Create Reseller Account',    preview: 'preview-reseller' },
          customer: { label: 'Create Customer Account',    preview: 'preview-customer' },
        };

        function switchRole(role, tab) {
          document.querySelectorAll('.role-tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');

          document.querySelectorAll('.dynamic-fields').forEach(f => f.classList.remove('visible'));
          document.getElementById('fields-' + role).classList.add('visible');

          document.getElementById('register-btn').textContent = roleConfig[role].label + ' →';

          document.querySelectorAll('.role-preview-card').forEach(c => c.classList.remove('active-role'));
          document.getElementById(roleConfig[role].preview).classList.add('active-role');
        }
    </script>

</body>
</html>
