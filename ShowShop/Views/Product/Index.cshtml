        --text-muted: #64748b;
        --border-soft: #e2e8f0;
        --bg-soft: #f8fafc;
        --radius-lg: 16px;
    } *@
   

<div class="page">
    <section class="hero">
        <div class="hero-header">
            <div>
                <h1 class="hero-title">Everything you need, in one place.</h1>
                <p class="hero-subtitle">Browse our curated collection. Fast delivery or pickup available.</p>
            </div>
        </div>
        <div class="hero-tags">
            <span class="tag">Fast Delivery</span>
            <span class="tag">Lagos, Nigeria</span>
            <span class="tag">Premium Quality</span>
        </div>
    </section>

    <section class="controls">
        <div class="category-strip" id="categoryStrip"></div>
        <div class="search-row">
            <input id="searchInput" type="search" class="search-input" placeholder="Search products..." />
            <button type="button" id="resetBtn" class="reset-btn">Clear</button>
        </div>
    </section>

    <section class="meta-row">
        <div id="resultsMeta">Choose a category to see products.</div>
        <div id="activeCategoryTag" class="meta-tag" style="display:none;"></div>
    </section>

    <!-- Detail view -->
    <section id="productDetail" class="product-detail" style="display:none;">
        <button type="button" id="backToList" class="back-btn">← Back to products</button>
        <div class="product-detail-card">
            <div class="product-detail-media">
                <img id="detailImage" src="" alt="" />
            </div>
            <div class="product-detail-body">
                <h1 id="detailTitle" class="product-detail-title"></h1>
                <div class="product-detail-meta">
                    <span id="detailPrice" class="product-price"></span>
                    <span id="detailStock" class="stock-pill"></span>
                </div>
                <p id="detailCategory" class="product-detail-category"></p>
                <p id="detailDescription" class="product-detail-desc"></p>
                <button type="button" id="detailOrderBtn" class="order-btn">
                    <span class="icon">💬</span>
                    <span>Order this on WhatsApp</span>
                </button>
            </div>
        </div>
    </section>

    <section id="productsSection">
        <div id="productsGrid" class="products-grid"></div>
        <div id="emptyState" class="empty-state" style="display:none;">
            <div class="empty-title">No products found.</div>
            <div>Try another category or search term.</div>
        </div>
    </section>

    <p class="footer-note">
        Need help? Chat with our team on WhatsApp or visit any <strong>Show Shop</strong> location.
    </p>
</div>

<script>
    // ────────────────────────────────────────────────
    // Mock data – this is what displays products right now
    // ────────────────────────────────────────────────
    var productsData = [
        { id: "P001", name: "Adult Dog Dry Food 15kg", category: "Pet Food", price: 28500, inStock: true, description: "Balanced nutrition for adult dogs. High protein, joint support.", imageUrl: "" },
        { id: "P002", name: "Kitten Wet Food Pouches 12×85g", category: "Pet Food", price: 9800, inStock: true, description: "Tender chunks in gravy – perfect for kittens.", imageUrl: "" },
        { id: "P003", name: "Extra Large Cat Scratching Post", category: "Cat Supplies", price: 16800, inStock: true, description: "Multi-level tower with sisal rope and plush bed.", imageUrl: "" },
        { id: "P004", name: "Dog Chew Toys – Rubber Bone Set", category: "Toys", price: 4200, inStock: true, description: "Durable, non-toxic rubber for heavy chewers.", imageUrl: "" },
        { id: "P005", name: "Dental Sticks for Dogs 500g", category: "Treats", price: 6500, inStock: false, description: "Helps reduce tartar & freshens breath.", imageUrl: "" },
        { id: "P006", name: "Flea & Tick Shampoo 500ml", category: "Grooming & Hygiene", price: 4800, inStock: true, description: "Gentle formula, kills fleas on contact.", imageUrl: "" },
        { id: "P007", name: "Multivitamin Drops for Cats 50ml", category: "Vitamins & Supplements", price: 7200, inStock: true, description: "Supports immune system and coat health.", imageUrl: "" },
        { id: "P008", name: "Puppy Training Pads 60pcs", category: "Training Pads", price: 9500, inStock: true, description: "Super absorbent with leak-proof edges.", imageUrl: "" },
        { id: "P009", name: "Pet Carrier Backpack", category: "Accessories", price: 14500, inStock: true, description: "Breathable mesh, suitable for cats & small dogs.", imageUrl: "" }
    ];

    var CATEGORY_IMAGES = {
        "Pet Food": "https://images.unsplash.com/photo-1589924691995-400dc9ecc0af?auto=format&fit=crop&w=600",
        "Grooming & Hygiene": "https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?auto=format&fit=crop&w=600",
        "Cat Supplies": "https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?auto=format&fit=crop&w=600",
        "Toys": "https://images.unsplash.com/photo-1583337130417-3346a1be7dee?auto=format&fit=crop&w=600",
        "Treats": "https://images.unsplash.com/photo-1583512603805-3cc6b41f3edb?auto=format&fit=crop&w=600",
        "Vitamins & Supplements": "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=600",
        "Training Pads": "https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?auto=format&fit=crop&w=600",
        "Accessories": "https://images.unsplash.com/photo-1589924691995-400dc9ecc0af?auto=format&fit=crop&w=600"
    };

    var DEFAULT_PRODUCT_IMAGE = "https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&w=800";
    var WHATSAPP_NUMBER = "2349122188759";  // ← change to your real number

    var ALL_CATEGORY = "__ALL__";
    var activeCategory = ALL_CATEGORY;
    var searchTerm = "";
    var currentProduct = null;
    var isLoading = false;

    // ────────────────────────────────────────────────
    // Loading / Error UI
    // ────────────────────────────────────────────────
    function showLoadingState() {
        $("body").append(
            '<div id="pageLoader" class="page-loader-overlay">' +
            '  <div class="page-loader-content">' +
            '    <div class="loader-spinner-large"></div>' +
            '    <div class="loader-text-large">Loading Store...</div>' +
            '  </div>' +
            '</div>'
        );
    }

    function hideLoadingState() {
        $("#pageLoader").fadeOut(300, function() { $(this).remove(); });
    }

    function showErrorState(message) {
        $("#productsGrid").html(
            '<div style="text-align:center; padding:40px; color:#ef4444;">' +
            '<div style="font-size:24px; margin-bottom:8px;">⚠️</div>' +
            '<div style="font-weight:600; margin-bottom:4px;">Failed to load products</div>' +
            '<div style="font-size:13px; color:#64748b;">' + message + '</div>' +
            '</div>'
        );
    }

    // ────────────────────────────────────────────────
    // Image helpers
    // ────────────────────────────────────────────────
    function getProductImage(product) {
        if (product.imageUrl && isRealProductImage(product.imageUrl)) {
            return product.imageUrl;
        }
        if (product.category && CATEGORY_IMAGES[product.category]) {
            return CATEGORY_IMAGES[product.category];
        }
        return DEFAULT_PRODUCT_IMAGE;
    }

    function isRealProductImage(url) {
        if (!url) return false;
        if (url === DEFAULT_PRODUCT_IMAGE) return false;
        if (url.includes('placeholder') || url.includes('/backupImages/')) return false;
        return url.startsWith('http://') || url.startsWith('https://');
    }

    // ────────────────────────────────────────────────
    // Formatting & URL building
    // ────────────────────────────────────────────────
    function formatNaira(amount) {
        if (typeof amount !== "number") return amount;
        return "₦" + amount.toLocaleString("en-NG");
    }

    function buildWhatsAppLink(product) {
        var detailUrl = window.location.origin + window.location.pathname + "#" + encodeURIComponent(product.id || "");
        var priceText = product.price != null ? formatNaira(product.price) : "Price on request";

        var message =
            "Hello Show Shop,\n" +
            "I would like to order:\n" +
            product.name + " (Code: " + product.id + ")\n" +
            "Price: " + priceText + "\n" +
            "More details: " + detailUrl + "\n" +
            "Please confirm availability and price.";

        return "https://wa.me/" + WHATSAPP_NUMBER + "?text=" + encodeURIComponent(message);
    }

    // ────────────────────────────────────────────────
    // Filtering & Rendering
    // ────────────────────────────────────────────────
    function uniqueCategories(list) {
        var seen = {};
        var result = [];
        list.forEach(function(item) {
            var cat = item.category || "Other";
            if (!seen[cat]) {
                seen[cat] = true;
                result.push(cat);
            }
        });
        return result.sort();
    }

    function applyFilters() {
        var filtered = productsData.slice();

        if (activeCategory && activeCategory !== ALL_CATEGORY) {
            filtered = filtered.filter(p => (p.category || "").toLowerCase() === activeCategory.toLowerCase());
        }

        if (searchTerm) {
            var term = searchTerm.toLowerCase();
            filtered = filtered.filter(p =>
                (p.name || "").toLowerCase().includes(term) ||
                (p.description || "").toLowerCase().includes(term)
            );
        }

        renderProducts(filtered);
        updateMeta(filtered.length);
    }

    function renderProducts(list) {
        var $grid = $("#productsGrid");
        $grid.empty();

        if (!list.length) {
            $("#emptyState").show();
            return;
        }

        $("#emptyState").hide();

        list.forEach(function(p) {
            var priceText = p.price != null ? formatNaira(p.price) : "Ask for price";
            var stockClass = p.inStock ? "" : " out";
            var stockLabel = p.inStock ? "In stock" : "Out of stock";
            var imageUrl = getProductImage(p);
            var isReal = isRealProductImage(imageUrl);
            var imgClass = isReal ? 'real-product-image' : '';

            var $card = $(
                '<article class="product-card">' +
                '  <div class="product-media product-clickable"><img loading="lazy" class="' + imgClass + '" src="' + imageUrl + '" alt="' + (p.name || "Product") + '" /></div>' +
                '  <h2 class="product-title product-clickable">' + (p.name || "Unnamed") + '</h2>' +
                '  <div class="product-meta">' +
                '    <span class="product-price">' + priceText + '</span>' +
                '    <span class="stock-pill' + stockClass + '">' + stockLabel + '</span>' +
                '  </div>' +
                '  <p class="product-desc">' + (p.description || "Ask our team for details.") + '</p>' +
                '  <div class="product-footer">' +
                '    <button type="button" class="order-btn"><span class="icon">💬</span><span>Order on WhatsApp</span></button>' +
                '    <button type="button" class="details-btn">Details</button>' +
                '  </div>' +
                '</article>'
            );

            $card.find(".order-btn").on("click", function() {
                window.location.href = buildWhatsAppLink(p);
            });

            $card.find(".details-btn, .product-clickable").on("click", function() {
                showProductDetail(p);
            });

            $grid.append($card);
        });
    }

    function updateMeta(count) {
        var metaText = "";
        if (activeCategory === ALL_CATEGORY) {
            metaText = count ? "Showing all products (" + count + ")" : "No products available.";
        } else if (!activeCategory) {
            metaText = "Choose a category to see products.";
        } else if (!count) {
            metaText = "No products found" + (searchTerm ? " for your search." : " in this category.");
        } else {
            metaText = count + " product" + (count > 1 ? "s" : "") + " found";
            if (searchTerm) metaText += ' for "' + searchTerm + '"';
        }
        $("#resultsMeta").text(metaText);

        var $tag = $("#activeCategoryTag");
        if (activeCategory && activeCategory !== ALL_CATEGORY) {
            $tag.text(activeCategory).show();
        } else {
            $tag.hide();
        }
    }

    // ────────────────────────────────────────────────
    // Detail view
    // ────────────────────────────────────────────────
    function showProductList() {
        $("#productDetail").hide();
        $("#productsSection").show();
        $(".controls").show();
        $(".meta-row").show();
    }

    function showProductDetail(product) {
        if (!product) return;
        currentProduct = product;

        var priceText = product.price != null ? formatNaira(product.price) : "Ask for price";
        var stockClass = product.inStock ? "" : " out";
        var stockLabel = product.inStock ? "In stock" : "Out of stock";
        var imageUrl = getProductImage(product);
        var isReal = isRealProductImage(imageUrl);

        $("#detailImage").attr({ src: imageUrl, alt: product.name || "Product" });
        $("#detailImage").toggleClass("real-product-image", isReal);

        $("#detailTitle").text(product.name || "Unnamed product");
        $("#detailPrice").text(priceText);
        $("#detailStock").text(stockLabel).toggleClass("out", !product.inStock);
        $("#detailCategory").text(product.category ? "Category: " + product.category : "");
        $("#detailDescription").text(product.description || "Ask our team for more details.");

        $("#detailOrderBtn").off("click").on("click", function() {
            window.location.href = buildWhatsAppLink(product);
        });

        window.location.hash = encodeURIComponent(product.id || "");

        $("#productsSection").hide();
        $(".controls").hide();
        $(".meta-row").hide();
        $("#productDetail").show();
    }

    // ────────────────────────────────────────────────
    // Categories
    // ────────────────────────────────────────────────
    function renderCategories() {
        var categories = uniqueCategories(productsData);
        var $strip = $("#categoryStrip");
        $strip.empty();

        var $all = $('<button type="button" class="category-pill">All</button>');
        $all.data("category", ALL_CATEGORY);
        $all.on("click", function() {
            activeCategory = ALL_CATEGORY;
            searchTerm = "";
            $("#searchInput").val("");
            $(".category-pill").removeClass("active");
            $(this).addClass("active");
            applyFilters();
        });
        $strip.append($all);

        categories.forEach(function(cat) {
            var $pill = $('<button type="button" class="category-pill">' + cat + '</button>');
            $pill.data("category", cat);
            $pill.on("click", function() {
                activeCategory = cat;
                searchTerm = "";
                $("#searchInput").val("");
                $(".category-pill").removeClass("active");
                $(this).addClass("active");
                applyFilters();
            });
            $strip.append($pill);
        });

        $(".category-pill").removeClass("active");
        $all.addClass("active");
        activeCategory = ALL_CATEGORY;
        applyFilters();
    }

    // ────────────────────────────────────────────────
    // Init
    // ────────────────────────────────────────────────
    $(function() {
        showLoadingState();

        // Simulate fast load for mock data
        setTimeout(function() {
            hideLoadingState();
            renderCategories();

            // Search
            $("#searchInput").on("input", function() {
                searchTerm = $(this).val().trim();
                applyFilters();
            });

            $("#resetBtn").on("click", function() {
                searchTerm = "";
                $("#searchInput").val("");
                applyFilters();
            });

            $("#backToList").on("click", function() {
                window.location.hash = "";
                showProductList();
            });

            // Deep link support
            var hash = window.location.hash ? window.location.hash.substring(1) : "";
            if (hash) {
                try { hash = decodeURIComponent(hash); } catch(e) {}
                var found = productsData.find(p => String(p.id) === hash);
                if (found) showProductDetail(found);
            }
        }, 600); // small delay so loader is visible briefly
    });
</script>