                                <div class="hiw-mock-line" style="width:30%"></div>
                                <div class="hiw-mock-line" style="width:20%;margin-left:8px"></div>
                                <div class="hiw-mock-pill" style="background:rgba(249,115,22,.15);color:#f97316">● New</div>
                            </div>
                            <div class="hiw-mock-row">
                                <div class="hiw-mock-dot" style="background:#3b82f6"></div>
                                <div class="hiw-mock-line" style="width:40%"></div>
                                <div class="hiw-mock-line" style="width:15%;margin-left:8px"></div>
                                <div class="hiw-mock-pill" style="background:rgba(59,130,246,.15);color:#3b82f6">Preparing</div>
