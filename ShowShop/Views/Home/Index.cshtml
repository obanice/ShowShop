    <script>
        /* ── Nav scroll effect ── */
        const nav = document.getElementById('main-nav');
        window.addEventListener('scroll', () => {
          nav.classList.toggle('scrolled', window.scrollY > 40);
        });

        /* ── Scroll reveal ── */
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((e, i) => {
            if (e.isIntersecting) {
              setTimeout(() => e.target.classList.add('visible'), i * 80);
              observer.unobserve(e.target);
            }
          });
        }, { threshold: 0.12 });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

        /* ── How It Works tab switch ── */
        function switchHIW(role, btn) {
          document.querySelectorAll('.hiw-tab').forEach(t => t.classList.remove('active'));
          btn.classList.add('active');
          document.querySelectorAll('.hiw-panel').forEach(p => p.classList.remove('active'));
          document.getElementById('hiw-' + role).classList.add('active');
        }

        /* ── Pricing tab switch ── */
        function switchPricing(type, btn) {
          document.querySelectorAll('.pricing-tab').forEach(t => t.classList.remove('active'));
          btn.classList.add('active');
          document.getElementById('pricing-owner').style.display    = type === 'owner'    ? 'grid' : 'none';
          document.getElementById('pricing-reseller').style.display = type === 'reseller' ? 'grid' : 'none';
        }
    </script>
