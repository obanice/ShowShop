<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ShowShop — The Digital Storefront for Nigerian Businesses</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet" />

    <style>
        /* ── TOKENS ── */
        :root {
            --green: #2e7d32;
            --green-mid: #43a047;
            --green-light: #e8f5e9;
            --green-glow: rgba(46,125,50,.18);
            --accent: #00c853;
            --dark: #0d1a0e;
            --dark-2: #152316;
            --ink: #111;
            --text: #374151;
            --muted: #6b7280;
            --border: #d1e7d1;
            --white: #ffffff;
            --cream: #f8fdf8;
            --font-display: 'Syne', sans-serif;
            --font-body: 'DM Sans', sans-serif;
            --radius: 12px;
            --radius-lg: 20px;
            --shadow: 0 4px 24px rgba(0,0,0,.08);
            --shadow-lg: 0 20px 60px rgba(0,0,0,.14);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font-body);
            color: var(--text);
            background: var(--white);
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        img {
            display: block;
            max-width: 100%;
        }

        /* ─────────────────────────────────────────
               NAV
            ───────────────────────────────────────── */
        .nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 48px;
            height: 73px;
            background: rgba(13,26,14,.92);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255,255,255,.07);
            transition: background .3s;
        }

            .nav.scrolled {
                background: rgba(13,26,14,.98);
            }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-logo-icon {
            width: 36px;
            height: 36px;
            background: var(--accent);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-display);
            font-weight: 800;
            font-size: 13px;
            color: var(--dark);
            letter-spacing: -0.5px;
        }

        .nav-logo-text {
            font-family: var(--font-display);
            font-weight: 800;
            font-size: 18px;
            color: var(--white);
            letter-spacing: -0.3px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 36px;
            list-style: none;
        }

            .nav-links a {
                font-size: 14px;
                font-weight: 500;
                color: rgba(255,255,255,.65);
                transition: color .2s;
            }

                .nav-links a:hover {
                    color: var(--white);
                }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn-nav-ghost {
            padding: 9px 20px;
            border-radius: 8px;
            font-family: var(--font-body);
            font-size: 14px;
            font-weight: 500;
            color: rgba(255,255,255,.8);
            background: transparent;
            border: 1px solid rgba(255,255,255,.2);
            cursor: pointer;
            transition: all .2s;
        }

            .btn-nav-ghost:hover {
                background: rgba(255,255,255,.1);
                color: var(--white);
            }

        .btn-nav-primary {
            padding: 9px 22px;
            border-radius: 8px;
            font-family: var(--font-body);
            font-size: 14px;
            font-weight: 600;
            color: var(--dark);
            background: var(--accent);
            border: none;
            cursor: pointer;
            transition: all .2s;
        }

            .btn-nav-primary:hover {
                background: #69f0ae;
                transform: translateY(-1px);
            }

        /* ─────────────────────────────────────────
               HERO
            ───────────────────────────────────────── */
        .hero {
            min-height: 100vh;
            background: var(--dark);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 120px 24px 80px;
            position: relative;
            overflow: hidden;
        }

            /* Radial glow behind headline */
            .hero::before {
                content: '';
                position: absolute;
                top: 20%;
                left: 50%;
                transform: translate(-50%, -50%);
                width: 700px;
                height: 700px;
                background: radial-gradient(circle, rgba(0,200,83,.13) 0%, transparent 65%);
                pointer-events: none;
            }

            /* Animated grid lines */
            .hero::after {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
                background-size: 60px 60px;
                pointer-events: none;
                mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black, transparent);
            }

        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(0,200,83,.12);
            border: 1px solid rgba(0,200,83,.25);
            color: var(--accent);
            font-size: 13px;
            font-weight: 600;
            padding: 6px 16px;
            border-radius: 99px;
            margin-bottom: 28px;
            position: relative;
            z-index: 1;
            animation: fadeDown .6s ease both;
        }

            .hero-eyebrow .dot {
                width: 7px;
                height: 7px;
                background: var(--accent);
                border-radius: 50%;
                animation: pulse 2s infinite;
            }

        @@keyframes pulse {
            0%, 100%

        {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: .5;
            transform: scale(.7);
        }

        }

        .hero-headline {
            font-family: var(--font-display);
            font-weight: 800;
            font-size: clamp(42px, 7vw, 86px);
            line-height: 1.02;
            letter-spacing: -2px;
            color: var(--white);
            margin-bottom: 24px;
            position: relative;
            z-index: 1;
            animation: fadeDown .6s .1s ease both;
            max-width: 900px;
        }

            .hero-headline .accent-word {
                color: var(--accent);
                position: relative;
            }

                .hero-headline .accent-word::after {
                    content: '';
                    position: absolute;
                    left: 0;
                    right: 0;
                    bottom: -4px;
                    height: 3px;
                    background: var(--accent);
                    border-radius: 2px;
                    opacity: .5;
                }

        .hero-sub {
            font-size: clamp(16px, 2.2vw, 20px);
            color: rgba(255,255,255,.6);
            max-width: 580px;
            line-height: 1.65;
            margin-bottom: 48px;
            position: relative;
            z-index: 1;
            animation: fadeDown .6s .2s ease both;
        }

        /* Three role CTA buttons */
        .hero-cta-group {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 56px;
            position: relative;
            z-index: 1;
            animation: fadeDown .6s .3s ease both;
        }

        .btn-role {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px 26px;
            border-radius: 12px;
            font-family: var(--font-body);
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all .22s;
            text-decoration: none;
        }

        .btn-role-primary {
            background: var(--accent);
            color: var(--dark);
        }

            .btn-role-primary:hover {
                background: #69f0ae;
                transform: translateY(-2px);
                box-shadow: 0 8px 28px rgba(0,200,83,.35);
            }

        .btn-role-outline {
            background: rgba(255,255,255,.06);
            color: var(--white);
            border: 1px solid rgba(255,255,255,.18);
        }

            .btn-role-outline:hover {
                background: rgba(255,255,255,.12);
                transform: translateY(-2px);
            }

        .btn-role-icon {
            font-size: 18px;
        }

        /* Hero stat strip */
        .hero-stats {
            display: flex;
            gap: 0;
            justify-content: center;
            position: relative;
            z-index: 1;
            animation: fadeDown .6s .4s ease both;
            border: 1px solid rgba(255,255,255,.09);
            border-radius: 14px;
            overflow: hidden;
            background: rgba(255,255,255,.04);
            backdrop-filter: blur(8px);
            max-width: 640px;
            width: 100%;
        }

        .hero-stat {
            flex: 1;
            padding: 18px 24px;
            text-align: center;
            border-right: 1px solid rgba(255,255,255,.08);
        }

            .hero-stat:last-child {
                border-right: none;
            }

            .hero-stat strong {
                display: block;
                font-family: var(--font-display);
                font-size: 26px;
                font-weight: 800;
                color: var(--white);
                margin-bottom: 3px;
            }

            .hero-stat span {
                font-size: 12px;
                color: rgba(255,255,255,.45);
                font-weight: 500;
            }

        /* Scroll arrow */
        .scroll-hint {
            position: absolute;
            bottom: 32px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            color: rgba(255,255,255,.3);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            z-index: 1;
            animation: fadeDown 1s .8s ease both;
        }

        .scroll-arrow {
            width: 20px;
            height: 20px;
            border-right: 2px solid rgba(255,255,255,.2);
            border-bottom: 2px solid rgba(255,255,255,.2);
            transform: rotate(45deg);
            animation: bounce 1.8s infinite;
        }

        @@keyframes bounce {
            0%, 100%

        {
            transform: rotate(45deg) translateY(0);
        }

        50% {
            transform: rotate(45deg) translateY(5px);
        }

        }

        /* ─────────────────────────────────────────
               SHARED SECTION STYLES
            ───────────────────────────────────────── */
        section {
            padding: 100px 24px;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
        }

        .section-eyebrow {
            display: inline-block;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--green);
            margin-bottom: 14px;
        }

        .section-headline {
            font-family: var(--font-display);
            font-size: clamp(30px, 4.5vw, 52px);
            font-weight: 800;
            color: var(--ink);
            line-height: 1.08;
            letter-spacing: -1px;
            margin-bottom: 16px;
        }

        .section-sub {
            font-size: 17px;
            color: var(--muted);
            line-height: 1.7;
            max-width: 560px;
        }

        /* ─────────────────────────────────────────
               PROBLEM SECTION
            ───────────────────────────────────────── */
        .problem {
            background: var(--dark-2);
            padding: 100px 24px;
        }

            .problem .section-eyebrow {
                color: #f97316;
            }

            .problem .section-headline {
                color: var(--white);
            }

            .problem .section-sub {
                color: rgba(255,255,255,.5);
            }

        .problem-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 56px;
        }

        .problem-card {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: var(--radius-lg);
            padding: 32px 28px;
            position: relative;
            overflow: hidden;
            transition: border-color .2s;
        }

            .problem-card:hover {
                border-color: rgba(249,115,22,.3);
            }

            .problem-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 2px;
                background: linear-gradient(90deg, #f97316, transparent);
                opacity: 0;
                transition: opacity .2s;
            }

            .problem-card:hover::before {
                opacity: 1;
            }

        .problem-number {
            font-family: var(--font-display);
            font-size: 52px;
            font-weight: 800;
            color: #f97316;
            line-height: 1;
            margin-bottom: 8px;
            opacity: .9;
        }

        .problem-card h3 {
            font-size: 16px;
            font-weight: 600;
            color: var(--white);
            margin-bottom: 10px;
        }

        .problem-card p {
            font-size: 14px;
            color: rgba(255,255,255,.45);
            line-height: 1.65;
        }

        .problem-resolution {
            margin-top: 56px;
            display: flex;
            align-items: center;
            gap: 20px;
            background: rgba(0,200,83,.07);
            border: 1px solid rgba(0,200,83,.2);
            border-radius: var(--radius-lg);
            padding: 28px 36px;
        }

        .problem-resolution-icon {
            font-size: 36px;
            flex-shrink: 0;
        }

        .problem-resolution h3 {
            font-family: var(--font-display);
            font-size: 22px;
            font-weight: 800;
            color: var(--white);
            margin-bottom: 6px;
        }

        .problem-resolution p {
            font-size: 15px;
            color: rgba(255,255,255,.55);
            line-height: 1.6;
            max-width: 700px;
        }

        .problem-resolution .accent-text {
            color: var(--accent);
            font-weight: 600;
        }

        /* ─────────────────────────────────────────
               HOW IT WORKS
            ───────────────────────────────────────── */
        .hiw {
            background: var(--cream);
        }

        .hiw-tabs {
            display: flex;
            gap: 0;
            background: #e4ede4;
            border-radius: 14px;
            padding: 5px;
            margin: 48px auto 0;
            max-width: 520px;
        }

        .hiw-tab {
            flex: 1;
            padding: 11px 16px;
            border-radius: 10px;
            background: transparent;
            border: none;
            font-family: var(--font-body);
            font-size: 14px;
            font-weight: 500;
            color: var(--muted);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            transition: all .2s;
        }

            .hiw-tab.active {
                background: var(--white);
                color: var(--green);
                font-weight: 600;
                box-shadow: 0 2px 8px rgba(0,0,0,.08);
            }

            .hiw-tab:hover:not(.active) {
                color: var(--ink);
            }

        .hiw-panels {
            margin-top: 48px;
        }

        .hiw-panel {
            display: none;
        }

            .hiw-panel.active {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 56px;
                align-items: center;
            }

        .hiw-steps {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .hiw-step {
            display: flex;
            gap: 18px;
            padding: 20px 0;
            border-bottom: 1px solid var(--border);
            position: relative;
        }

            .hiw-step:last-child {
                border-bottom: none;
            }

        .hiw-step-num {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--green);
            color: var(--white);
            font-weight: 700;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .hiw-step-content h4 {
            font-size: 15px;
            font-weight: 600;
            color: var(--ink);
            margin-bottom: 5px;
        }

        .hiw-step-content p {
            font-size: 14px;
            color: var(--muted);
            line-height: 1.6;
        }

        /* Visual / mock card panel on the right */
        .hiw-visual {
            background: var(--dark);
            border-radius: var(--radius-lg);
            overflow: hidden;
            aspect-ratio: 4/3;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 28px;
            position: relative;
        }

            .hiw-visual::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(circle at 30% 30%, rgba(0,200,83,.12), transparent 60%);
            }

        .hiw-mock-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: rgba(255,255,255,.35);
            margin-bottom: 12px;
            position: relative;
            z-index: 1;
        }

        .hiw-mock-card {
            background: rgba(255,255,255,.07);
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 12px;
            padding: 16px;
            position: relative;
            z-index: 1;
        }

        .hiw-mock-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 10px;
        }

            .hiw-mock-row:last-child {
                margin-bottom: 0;
            }

        .hiw-mock-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .hiw-mock-line {
            height: 10px;
            border-radius: 4px;
            background: rgba(255,255,255,.15);
        }

        .hiw-mock-pill {
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            margin-left: auto;
            flex-shrink: 0;
        }

        /* ─────────────────────────────────────────
               FEATURES
            ───────────────────────────────────────── */
        .features {
            background: var(--white);
        }

        .features-header {
            text-align: center;
            margin-bottom: 60px;
        }

            .features-header .section-sub {
                margin: 0 auto;
            }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .feature-card {
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 32px 28px;
            transition: all .2s;
            background: var(--white);
            position: relative;
            overflow: hidden;
        }

            .feature-card::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: linear-gradient(90deg, var(--green), var(--accent));
                transform: scaleX(0);
                transform-origin: left;
                transition: transform .3s;
            }

            .feature-card:hover {
                border-color: var(--green);
                box-shadow: 0 8px 32px rgba(46,125,50,.1);
                transform: translateY(-3px);
            }

                .feature-card:hover::after {
                    transform: scaleX(1);
                }

        .feature-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: var(--green-light);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin-bottom: 20px;
        }

        .feature-card h3 {
            font-size: 17px;
            font-weight: 600;
            color: var(--ink);
            margin-bottom: 10px;
        }

        .feature-card p {
            font-size: 14px;
            color: var(--muted);
            line-height: 1.7;
        }

        .feature-tag {
            display: inline-flex;
            margin-top: 16px;
            font-size: 11px;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 20px;
            background: var(--green-light);
            color: var(--green);
        }

        /* ─────────────────────────────────────────
               RESELLER SPOTLIGHT
            ───────────────────────────────────────── */
        .reseller-spotlight {
            background: var(--dark);
            padding: 100px 24px;
        }

        .reseller-inner {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 72px;
            align-items: center;
            max-width: 1100px;
            margin: 0 auto;
        }

        .reseller-content .section-eyebrow {
            color: #f59e0b;
        }

        .reseller-content .section-headline {
            color: var(--white);
            margin-bottom: 20px;
        }

        .reseller-content .section-sub {
            color: rgba(255,255,255,.5);
            margin-bottom: 36px;
        }

        .reseller-perks {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin-bottom: 36px;
        }

        .reseller-perk {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            font-size: 15px;
            color: rgba(255,255,255,.75);
            line-height: 1.5;
        }

        .perk-check {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: rgba(0,200,83,.15);
            border: 1px solid rgba(0,200,83,.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            color: var(--accent);
            flex-shrink: 0;
            margin-top: 1px;
        }

        /* Profit calc mockup */
        .profit-mock {
            background: rgba(255,255,255,.05);
            border: 1px solid rgba(255,255,255,.1);
            border-radius: var(--radius-lg);
            padding: 28px;
        }

        .profit-mock-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

            .profit-mock-header h4 {
                font-size: 14px;
                font-weight: 600;
                color: rgba(255,255,255,.7);
            }

        .profit-mock-badge {
            font-size: 11px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 20px;
            background: rgba(0,200,83,.15);
            color: var(--accent);
            border: 1px solid rgba(0,200,83,.25);
        }

        .profit-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }

            .profit-item:last-of-type {
                border-bottom: none;
            }

        .profit-item-name {
            font-size: 13px;
            color: rgba(255,255,255,.6);
        }

        .profit-item-prices {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .cost-price {
            font-size: 13px;
            color: rgba(255,255,255,.3);
            text-decoration: line-through;
        }

        .my-price {
            font-size: 14px;
            font-weight: 600;
            color: var(--white);
        }

        .profit-badge {
            font-size: 11px;
            font-weight: 700;
            color: var(--accent);
            background: rgba(0,200,83,.12);
            padding: 2px 8px;
            border-radius: 6px;
        }

        .profit-total {
            margin-top: 16px;
            padding: 14px 16px;
            background: rgba(0,200,83,.08);
            border: 1px solid rgba(0,200,83,.2);
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .profit-total-label {
            font-size: 13px;
            font-weight: 600;
            color: rgba(255,255,255,.6);
        }

        .profit-total-amount {
            font-family: var(--font-display);
            font-size: 22px;
            font-weight: 800;
            color: var(--accent);
        }

        /* ─────────────────────────────────────────
               PRICING
            ───────────────────────────────────────── */
        .pricing {
            background: var(--cream);
        }

        .pricing-header {
            text-align: center;
            margin-bottom: 16px;
        }

            .pricing-header .section-sub {
                margin: 0 auto 20px;
            }

        .pricing-toggle {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 48px;
        }

            .pricing-toggle span {
                font-size: 14px;
                font-weight: 500;
                color: var(--muted);
            }

                .pricing-toggle span.active {
                    color: var(--green);
                    font-weight: 600;
                }

        .toggle-switch {
            width: 44px;
            height: 24px;
            background: var(--green);
            border-radius: 12px;
            position: relative;
            cursor: pointer;
        }

            .toggle-switch::after {
                content: '';
                position: absolute;
                top: 3px;
                left: 3px;
                width: 18px;
                height: 18px;
                background: var(--white);
                border-radius: 50%;
                transition: transform .2s;
            }

        .pricing-tabs {
            display: flex;
            gap: 0;
            background: #e4ede4;
            border-radius: 14px;
            padding: 5px;
            margin: 0 auto 48px;
            max-width: 380px;
        }

        .pricing-tab {
            flex: 1;
            padding: 10px 16px;
            border-radius: 10px;
            background: transparent;
            border: none;
            font-family: var(--font-body);
            font-size: 14px;
            font-weight: 500;
            color: var(--muted);
            cursor: pointer;
            transition: all .2s;
            text-align: center;
        }

            .pricing-tab.active {
                background: var(--white);
                color: var(--green);
                font-weight: 600;
                box-shadow: 0 2px 8px rgba(0,0,0,.08);
            }

        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
        }

        .pricing-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 28px 24px;
            transition: all .2s;
            position: relative;
        }

            .pricing-card:hover {
                transform: translateY(-4px);
                box-shadow: var(--shadow-lg);
            }

            .pricing-card.featured {
                border-color: var(--green);
                background: var(--dark);
                box-shadow: 0 0 0 1px var(--green), 0 20px 60px rgba(46,125,50,.2);
            }

        .pricing-popular {
            position: absolute;
            top: -13px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--accent);
            color: var(--dark);
            font-size: 11px;
            font-weight: 700;
            padding: 4px 14px;
            border-radius: 20px;
            white-space: nowrap;
        }

        .plan-name {
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 10px;
        }

        .pricing-card.featured .plan-name {
            color: rgba(255,255,255,.5);
        }

        .plan-price {
            font-family: var(--font-display);
            font-size: 36px;
            font-weight: 800;
            color: var(--ink);
            line-height: 1;
            margin-bottom: 4px;
        }

        .pricing-card.featured .plan-price {
            color: var(--white);
        }

        .plan-price sub {
            font-size: 16px;
            font-weight: 400;
            font-family: var(--font-body);
            color: var(--muted);
        }

        .pricing-card.featured .plan-price sub {
            color: rgba(255,255,255,.4);
        }

        .plan-period {
            font-size: 13px;
            color: var(--muted);
            margin-bottom: 20px;
        }

        .pricing-card.featured .plan-period {
            color: rgba(255,255,255,.4);
        }

        .plan-divider {
            height: 1px;
            background: var(--border);
            margin-bottom: 20px;
        }

        .pricing-card.featured .plan-divider {
            background: rgba(255,255,255,.1);
        }

        .plan-features {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 11px;
            margin-bottom: 28px;
        }

        .plan-feature {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            font-size: 13px;
            color: var(--text);
            line-height: 1.45;
        }

        .pricing-card.featured .plan-feature {
            color: rgba(255,255,255,.7);
        }

        .plan-feature .chk {
            flex-shrink: 0;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 9px;
            margin-top: 1px;
        }

        .chk-yes {
            background: var(--green-light);
            color: var(--green);
        }

        .pricing-card.featured .chk-yes {
            background: rgba(0,200,83,.18);
            color: var(--accent);
        }

        .chk-no {
            background: #f3f4f6;
            color: #d1d5db;
        }

        .pricing-card.featured .chk-no {
            background: rgba(255,255,255,.07);
            color: rgba(255,255,255,.2);
        }

        .btn-plan {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            font-family: var(--font-body);
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all .2s;
        }

        .btn-plan-outline {
            background: transparent;
            border: 1.5px solid var(--border);
            color: var(--green);
        }

            .btn-plan-outline:hover {
                border-color: var(--green);
                background: var(--green-light);
            }

        .btn-plan-primary {
            background: var(--accent);
            color: var(--dark);
        }

            .btn-plan-primary:hover {
                background: #69f0ae;
                transform: translateY(-1px);
            }

        /* ─────────────────────────────────────────
               SOCIAL PROOF / TRUST BAR
            ───────────────────────────────────────── */
        .trust {
            background: var(--white);
            padding: 80px 24px;
        }

        .trust-inner {
            max-width: 1100px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 32px;
            align-items: center;
        }

        .trust-stat {
            text-align: center;
            padding: 32px;
            border-radius: var(--radius-lg);
            background: var(--cream);
            border: 1px solid var(--border);
        }

        .trust-stat-number {
            font-family: var(--font-display);
            font-size: 52px;
            font-weight: 800;
            color: var(--green);
            line-height: 1;
            margin-bottom: 6px;
        }

        .trust-stat-label {
            font-size: 15px;
            color: var(--muted);
            font-weight: 500;
        }

        /* Testimonial style trust quote */
        .trust-quote {
            grid-column: span 3;
            background: var(--dark);
            border-radius: var(--radius-lg);
            padding: 40px 48px;
            display: flex;
            align-items: center;
            gap: 48px;
        }

        .trust-quote-text {
            font-family: var(--font-display);
            font-size: 22px;
            font-weight: 700;
            color: var(--white);
            line-height: 1.4;
            flex: 1;
        }

            .trust-quote-text .hl {
                color: var(--accent);
            }

        .trust-quote-author {
            flex-shrink: 0;
            text-align: center;
        }

        .trust-quote-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: var(--green);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-display);
            font-size: 20px;
            font-weight: 800;
            color: var(--white);
            margin: 0 auto 10px;
        }

        .trust-quote-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--white);
            margin-bottom: 3px;
        }

        .trust-quote-role {
            font-size: 12px;
            color: rgba(255,255,255,.4);
        }

        /* ─────────────────────────────────────────
               FINAL CTA
            ───────────────────────────────────────── */
        .final-cta {
            background: var(--green);
            padding: 100px 24px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            .final-cta::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
                background-size: 40px 40px;
            }

            .final-cta h2 {
                font-family: var(--font-display);
                font-size: clamp(32px, 5vw, 60px);
                font-weight: 800;
                color: var(--white);
                line-height: 1.05;
                letter-spacing: -1.5px;
                margin-bottom: 16px;
                position: relative;
                z-index: 1;
            }

            .final-cta p {
                font-size: 18px;
                color: rgba(255,255,255,.75);
                margin-bottom: 40px;
                position: relative;
                z-index: 1;
            }

        .final-cta-btns {
            display: flex;
            gap: 14px;
            justify-content: center;
            flex-wrap: wrap;
            position: relative;
            z-index: 1;
        }

        .btn-cta-white {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 15px 30px;
            background: var(--white);
            color: var(--green);
            border-radius: 12px;
            font-size: 15px;
            font-weight: 700;
            font-family: var(--font-body);
            border: none;
            cursor: pointer;
            transition: all .2s;
            text-decoration: none;
        }

            .btn-cta-white:hover {
                background: var(--cream);
                transform: translateY(-2px);
                box-shadow: 0 8px 28px rgba(0,0,0,.15);
            }

        .btn-cta-ghost {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 15px 30px;
            background: rgba(255,255,255,.12);
            color: var(--white);
            border: 1.5px solid rgba(255,255,255,.3);
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            font-family: var(--font-body);
            cursor: pointer;
            transition: all .2s;
        }

            .btn-cta-ghost:hover {
                background: rgba(255,255,255,.2);
            }

        /* ─────────────────────────────────────────
               FOOTER
            ───────────────────────────────────────── */
        footer {
            background: var(--dark);
            padding: 64px 24px 32px;
            color: rgba(255,255,255,.5);
        }

        .footer-inner {
            max-width: 1100px;
            margin: 0 auto;
        }

        .footer-top {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 48px;
            margin-bottom: 48px;
        }

        .footer-brand .nav-logo {
            margin-bottom: 14px;
        }

        .footer-brand p {
            font-size: 14px;
            line-height: 1.7;
            color: rgba(255,255,255,.4);
            max-width: 280px;
            margin-bottom: 20px;
        }

        .footer-whatsapp {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(37,211,102,.12);
            border: 1px solid rgba(37,211,102,.25);
            color: #25d366;
            font-size: 13px;
            font-weight: 600;
            padding: 8px 16px;
            border-radius: 8px;
            transition: background .2s;
        }

            .footer-whatsapp:hover {
                background: rgba(37,211,102,.2);
            }

        .footer-col h4 {
            font-size: 13px;
            font-weight: 700;
            color: var(--white);
            letter-spacing: 0.04em;
            margin-bottom: 16px;
        }

        .footer-col ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

            .footer-col ul a {
                font-size: 14px;
                color: rgba(255,255,255,.4);
                transition: color .2s;
            }

                .footer-col ul a:hover {
                    color: var(--white);
                }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,.07);
            padding-top: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
        }

        .footer-bottom-right {
            display: flex;
            gap: 24px;
        }

        .footer-bottom a {
            color: rgba(255,255,255,.35);
            transition: color .2s;
        }

            .footer-bottom a:hover {
                color: var(--white);
            }

        /* ─────────────────────────────────────────
               ANIMATIONS
            ───────────────────────────────────────── */
        @@keyframes fadeDown {
            from

        {
            opacity: 0;
            transform: translateY(-16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        /* Scroll reveal */
        .reveal {
            opacity: 0;
            transform: translateY(28px);
            transition: opacity .6s ease, transform .6s ease;
        }

            .reveal.visible {
                opacity: 1;
                transform: translateY(0);
            }

        /* ─────────────────────────────────────────
               RESPONSIVE
            ───────────────────────────────────────── */
        @@media (max-width: 1024px) {
            .pricing-grid

        {
            grid-template-columns: repeat(2, 1fr);
        }

        .footer-top {
            grid-template-columns: 1fr 1fr;
        }

        }

        @@media (max-width: 800px) {
            .nav-links

        {
            display: none;
        }

        .nav {
            padding: 0 24px;
        }

        .problem-grid {
            grid-template-columns: 1fr;
        }

        .features-grid {
            grid-template-columns: 1fr;
        }

        .hiw-panel.active {
            grid-template-columns: 1fr;
        }

        .hiw-visual {
            display: none;
        }

        .reseller-inner {
            grid-template-columns: 1fr;
        }

        .pricing-grid {
            grid-template-columns: 1fr;
        }

        .trust-inner {
            grid-template-columns: 1fr;
        }

        .trust-quote {
            grid-column: span 1;
            flex-direction: column;
            text-align: center;
        }

        .footer-top {
            grid-template-columns: 1fr;
            gap: 32px;
        }

        .footer-bottom {
            flex-direction: column;
            gap: 12px;
            text-align: center;
        }

        .problem-resolution {
            flex-direction: column;
            text-align: center;
        }

        }
    </style>
</head>
