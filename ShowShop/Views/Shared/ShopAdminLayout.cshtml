<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ShowShop — Add Product</title>
    <link rel="stylesheet" href="../css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="../css/shopowner-layout.css" asp-append-version="true" />
</head>
<body class="shopowner-layout">

    <!-- ── TOP APP NAV ── -->
    <nav class="app-nav">
        <a class="logo" href="dashboard.html">
            <div class="logo-icon">SQ</div>
            <span class="logo-text">ShowShop</span>
        </a>
        <div class="app-nav-right">
            <button class="nav-notif">🔔<span class="notif-dot"></span></button>
            <div class="nav-user">
                <strong>Emeka Okafor</strong>
                <span>Shop Owner · Free Plan</span>
            </div>
            <div class="nav-avatar">EO</div>
        </div>
    </nav>

    <!-- ── APP SHELL ── -->
    <div class="app-layout">

        <!-- SIDEBAR -->
        <aside class="app-sidebar">
            <span class="sidebar-section-label">Main</span>
            <a class="sidebar-item" href="dashboard.html" data-page="dashboard">
                <span class="sidebar-icon">🏠</span> Dashboard
            </a>
            <a class="sidebar-item active" href="#" data-page="products">
                <span class="sidebar-icon">📦</span> Products
            </a>
            <a class="sidebar-item" href="#" data-page="orders">
                <span class="sidebar-icon">📋</span> Orders
                <span class="sidebar-badge">3</span>
            </a>
            <a class="sidebar-item" href="#" data-page="share-shop">
                <span class="sidebar-icon">🔗</span> Share My Shop
            </a>

            <span class="sidebar-section-label">Manage</span>
            <a class="sidebar-item" href="#" data-page="analytics">
                <span class="sidebar-icon">📊</span> Analytics
            </a>
            <a class="sidebar-item" href="#" data-page="notifications">
                <span class="sidebar-icon">🔔</span> Notifications
                <span class="sidebar-badge">5</span>
            </a>
            <a class="sidebar-item" href="#" data-page="shop-settings">
                <span class="sidebar-icon">⚙️</span> Shop Settings
            </a>
            <a class="sidebar-item" href="#" data-page="profile">
                <span class="sidebar-icon">👤</span> Profile
            </a>

            <div class="sidebar-footer">
                <div class="plan-chip">⚡ Free Plan</div>
                <button class="sidebar-upgrade-btn">Upgrade Plan →</button>
            </div>
        </aside>

        <!-- ── PAGE BODY ── -->
        <main class="app-main">

            @RenderBody()

        </main>

    </div>

    <script>
        const subcategories = {
          pipes:    ['PVC', 'HDPE', 'PPR', 'Galvanized', 'Copper'],
          fittings: ['Elbows', 'Tees', 'Reducers', 'Couplings', 'End Caps'],
          valves:   ['Gate Valve', 'Ball Valve', 'Check Valve', 'Pressure Relief'],
          tools:    ['Pipe Cutters', 'Wrenches', 'Sealants', 'Tape'],
          other:    ['Miscellaneous'],
        };

        function updateSubcategory() {
          const cat = document.getElementById('category').value;
          const sub = document.getElementById('subcategory');
          sub.innerHTML = '<option value="" disabled selected>Select sub-category</option>';
          (subcategories[cat] || []).forEach(s => {
            const o = document.createElement('option');
            o.textContent = s;
            sub.appendChild(o);
          });
        }

        function updatePreview() {
          const name  = document.getElementById('product-name').value || 'Product name';
          const brand = document.getElementById('brand-name').value   || 'Brand';
          const cat   = document.getElementById('category');
          const catLabel = cat.options[cat.selectedIndex]?.text || 'Category';
          const price = document.getElementById('price-main').value;

          document.getElementById('prev-name').textContent  = name;
          document.getElementById('prev-brand').textContent = `${brand} · ${catLabel}`;
          document.getElementById('prev-cat').textContent   = catLabel !== 'Category' ? catLabel : 'All sizes';
          document.getElementById('prev-price').innerHTML   = price
            ? `₦${Number(price).toLocaleString()}<span> / unit</span>`
            : `₦ —<span> / unit</span>`;
        }

        function addVariant() {
          const input = document.getElementById('new-variant');
          const val = input.value.trim();
          if (!val) return;
          const list = document.getElementById('variant-list');
          const tag  = document.createElement('div');
          tag.className = 'variant-tag';
          tag.innerHTML = `${val} <span class="remove" onclick="removeVariant(this)">×</span>`;
          list.appendChild(tag);
          input.value = '';
        }

        function removeVariant(el) { el.parentElement.remove(); }

        function previewMainImage(e) {
          const file = e.target.files[0];
          if (!file) return;
          const reader = new FileReader();
          reader.onload = ev => {
            const area = document.getElementById('preview-img-area');
            area.innerHTML = '';
            area.style.background = 'none';
            const img = document.createElement('img');
            img.src = ev.target.result;
            area.appendChild(img);
          };
          reader.readAsDataURL(file);
        }

        function saveProduct() {
          const name  = document.getElementById('product-name').value.trim();
          const brand = document.getElementById('brand-name').value.trim();
          const price = document.getElementById('price-main').value.trim();
          if (!name || !brand || !price) {
            alert('Please fill in Product Name, Brand Name, and Price before saving.');
            return;
          }
          alert('✅ Product saved! Redirecting to your product list…');
          window.location = 'dashboard.html';
        }
    </script>

</body>
</html>
